    <!-- Opt-in thin distribution: retain reflective/JNI dependencies without
         changing the inherited development packaging. Launcher tooling supplies
         an explicit, hashed classpath and platform-matched LWJGL runtime. -->
    <profiles>
        <profile>
            <id>launcher-dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <executions><execution><id>default</id><phase>none</phase></execution></executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <executions><execution><id>default</id><phase>none</phase></execution></executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>3.3.0</version>
                        <configuration>
                            <finalName>neutron-client</finalName>
                            <archive><manifest><mainClass>me.neutron.launcher.ClientBootstrap</mainClass></manifest></archive>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>launcher-runtime</id><phase>package</phase>
                                <goals><goal>copy-dependencies</goal></goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <useRepositoryLayout>true</useRepositoryLayout>
                                    <outputDirectory>${project.build.directory}/launcher-libraries</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
